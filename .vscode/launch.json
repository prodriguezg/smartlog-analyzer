{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend (Docker Compose)",
      "type": "node",
      "request": "attach",
      "address": "127.0.0.1",
      "port": 9229,
      "localRoot": "${workspaceFolder}/backend",
